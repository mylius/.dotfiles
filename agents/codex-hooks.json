{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 -I $HOME/.dotfiles/agents/hooks/agent-bash-guard", "timeout": 10},
          {"type": "command", "command": "python3 -I $HOME/.dotfiles/agents/hooks/codex-wait-guard", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 -I $HOME/.dotfiles/agents/hooks/agent-stop-guard", "timeout": 10}
        ]
      }
    ]
  }
}
