#!/usr/bin/env zsh
set -euo pipefail

typeset -a MAT_SKILLS
MAT_SKILLS=(
  grill-me
  grill-with-docs
  wait-what
  wayfinder
  teach
  to-spec
  to-tickets
  domain-modeling
  codebase-design
  improve-codebase-architecture
  writing-for-agents
)

command -v npx >/dev/null || { echo "npx missing" >&2; exit 1; }

# Run from $HOME with -g: from inside a repo, `skills add` installs every skill
# in the package into that repo's .agents/.claude/.codex instead.
cd "$HOME"

# --skill takes a space-separated list; `--skill=name` is ignored and installs every skill.
npx skills@latest add mattpocock/skills -g -y --skill ${MAT_SKILLS[@]} >/dev/null || {
  echo "mattpocock/skills install failed" >&2
  exit 1
}

npx skills@latest add backnotprop/pstack -g -y --skill unslop >/dev/null

npx impeccable install >/dev/null 2>&1 || echo "impeccable install skipped (needs manual run)" >&2

# Match agents-sync: Claude reads skills from its config dir, not always ~/.claude.
DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
source "$DOTFILES/env/.config/env"
claude_skills="${CLAUDE_CONFIG_DIR:-$WORKSPACE_ROOT/.claude}/skills"

mkdir -p "$HOME/.agents/skills" "$claude_skills" "$HOME/.cursor/skills"

# Skills kept in the dotfiles: $DOTFILES/skills on every machine,
# $DOTFILES/skills-private on private machines, $DOTFILES_WORK/skills on work ones.
typeset -a skill_dirs
skill_dirs=("$DOTFILES/skills")
if [[ $DOTFILES_PROFILE == work ]]; then
  skill_dirs+=("$DOTFILES_WORK/skills")
else
  skill_dirs+=("$DOTFILES/skills-private")
fi
for dir in "${skill_dirs[@]}"; do
  for d in "$dir"/*(N/); do
    ln -sfn "$d" "$HOME/.agents/skills/${d:t}"
  done
done

for d in "$HOME/.agents/skills"/*(N/); do
  name="${d:t}"
  [[ "$name" = "synced" ]] && continue
  [[ -e "$claude_skills/$name" ]] || ln -s "$d" "$claude_skills/$name"
  [[ -e "$HOME/.cursor/skills/$name" ]] || ln -s "../../.agents/skills/$name" "$HOME/.cursor/skills/$name"
done

echo "skills synced:"
ls "$HOME/.agents/skills"