#!/usr/bin/env python3
"""Run shell commands in the background and notify agents when they finish.

Each task gets a detached supervisor process that runs the command, writes its
output to a log, and on exit (or on output lines matching --match) notifies
every subscriber:

  codex:THREAD   queue the notification into a Codex session (`codex queue`),
                 which starts a new turn if the session is idle.
  exec:COMMAND   run COMMAND via sh with the notification on stdin and
                 BGTASK_ID, BGTASK_STATUS, BGTASK_EXIT_CODE, BGTASK_OUTPUT set.

Inside the Codex CLI, `run` subscribes the calling session through
$CODEX_THREAD_ID. Codex sessions under T3 can't be woken this way; they hand
`bgtask wait` to an async T3 child task, whose completion wakes them.

Codex's sandbox kills every process a command started once that command
exits, so a sandboxed `run` only files the task. `bgtask daemon`, running
outside the sandbox, picks it up and runs it under `codex sandbox` with
workspace-write access to the task's cwd plus network. Bazel can't run there
(its output base is outside the writable roots), so `run` refuses Bazel
commands from the sandbox; start those with escalated permissions. Only cwds under
$BGTASK_ROOTS (colon-separated) are accepted.

State lives in $BGTASK_HOME (default /tmp/bgtask-$UID), one directory per task.
"""
import argparse
import datetime
import fcntl
import json
import os
import re
import secrets
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path(os.environ.get("BGTASK_HOME") or f"/tmp/bgtask-{os.getuid()}")
ROOTS = os.environ.get("BGTASK_ROOTS", "/workspace/wt:/workspace/t3-worktrees:/tmp")
HEARTBEAT_STALE = 15  # seconds without a heartbeat before a process counts as gone
TAIL_LINES = 20
TAIL_CHARS = 3000
MATCH_WINDOW = 10  # seconds of matched lines batched into one notification
SANDBOX_PROFILE = ["-P", "bgtask", "-c", 'permissions.bgtask.extends=":workspace"',
                   "-c", "permissions.bgtask.network.enabled=true"]


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def in_codex_sandbox():
    # Codex runs sandboxed commands in a PID namespace whose PID 1 is its own helper.
    try:
        return Path("/proc/1/comm").read_text().strip() in ("codex", "bwrap")
    except OSError:
        return False


def fresh(path):
    try:
        return time.time() - path.stat().st_mtime < HEARTBEAT_STALE
    except FileNotFoundError:
        return False


def beat(path, stop):
    while not stop.is_set():
        path.touch()
        stop.wait(2)


def task_dir(task_id):
    d = HOME / task_id
    if not (d / "meta.json").exists():
        sys.exit(f"bgtask: no task {task_id}")
    return d


def read_meta(d):
    return json.loads((d / "meta.json").read_text())


def write_meta(d, meta):
    tmp = d / f"meta.json.{os.getpid()}"
    tmp.write_text(json.dumps(meta, indent=2))
    tmp.replace(d / "meta.json")


def update_meta(d, **fields):
    with open(d / "meta.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        meta = read_meta(d)
        meta.update(fields)
        write_meta(d, meta)
    return meta


def effective_status(d, meta):
    if meta["status"] == "running" and not fresh(d / "heartbeat"):
        return "lost"
    if meta["status"] == "queued" and meta["sandboxed"] and not fresh(HOME / "daemon.heartbeat"):
        return "queued (daemon not running)"
    return meta["status"]


def tail(path, lines=TAIL_LINES, chars=TAIL_CHARS):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 64 * 1024))
            text = f.read().decode(errors="replace")
    except FileNotFoundError:
        return ""
    return "\n".join(text.splitlines()[-lines:])[-chars:]


def subscribers(d):
    try:
        return [s for s in (d / "subscribers").read_text().splitlines() if s]
    except FileNotFoundError:
        return []


def add_subscriber(d, target):
    if not re.fullmatch(r"(codex:[\w.-]+|exec:.+)", target):
        sys.exit(f"bgtask: bad notify target {target!r}; use codex:THREAD or exec:COMMAND")
    if target not in subscribers(d):
        with open(d / "subscribers", "a") as f:
            f.write(target + "\n")


def render(meta, kind, body):
    lines = ["<background-task-notification>",
             f"<task-id>{meta['id']}</task-id>",
             f"<task-name>{meta['name']}</task-name>"]
    if kind == "exit":
        lines.append(f"<status>{meta['status']}</status>")
        if meta.get("exit_code") is not None:
            lines.append(f"<exit-code>{meta['exit_code']}</exit-code>")
        if meta.get("error"):
            lines.append(f"<error>{meta['error']}</error>")
    else:
        lines.append("<status>running</status>")
        lines.append(f"<event>output matched {meta['match']}</event>")
    lines += [f"<output-file>{meta['output']}</output-file>",
              f"<output-tail>\n{body}\n</output-tail>",
              "</background-task-notification>"]
    return "\n".join(lines)


def deliver(d, meta, kind, body, only=None):
    message = render(meta, kind, body)
    for target in [only] if only else subscribers(d):
        scheme, _, value = target.partition(":")
        if scheme == "codex":
            cmd, stdin = ["codex", "queue", "--thread", value, "--message", message], None
        else:
            cmd, stdin = ["sh", "-c", value], message + "\n"
        env = dict(os.environ, BGTASK_ID=meta["id"], BGTASK_STATUS=meta["status"],
                   BGTASK_EXIT_CODE="" if meta.get("exit_code") is None else str(meta["exit_code"]),
                   BGTASK_OUTPUT=meta["output"])
        try:
            r = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=60,
                               env=env, stdin=None if stdin else subprocess.DEVNULL)
            result = f"exit {r.returncode} {(r.stdout + r.stderr).strip()[:300]}"
        except Exception as e:  # keep notifying the remaining subscribers
            result = f"error {e}"
        with open(d / "notify.log", "a") as f:
            f.write(f"{now()} {kind} {target}: {result}\n")


def allowed_cwd(cwd):
    real = os.path.realpath(cwd)
    return any(real == r or real.startswith(r.rstrip("/") + "/")
               for r in (os.path.realpath(p) for p in ROOTS.split(":") if p))


def finish(d, **fields):
    meta = update_meta(d, finished=now(), **fields)
    deliver(d, meta, "exit", tail(d / "output.log"))


def supervise(task_id):
    d = HOME / task_id
    meta = read_meta(d)
    stop = threading.Event()
    threading.Thread(target=beat, args=(d / "heartbeat", stop), daemon=True).start()
    argv = meta["argv"]
    if meta["sandboxed"]:
        if not allowed_cwd(meta["cwd"]):
            stop.set()
            return finish(d, status="rejected",
                          error=f"cwd {meta['cwd']} is outside BGTASK_ROOTS ({ROOTS})")
        argv = ["codex", "sandbox", *SANDBOX_PROFILE, "-C", meta["cwd"], "--", *argv]
    pattern = re.compile(meta["match"]) if meta.get("match") else None
    out = open(d / "output.log", "ab", buffering=0)
    try:
        proc = subprocess.Popen(argv, cwd=meta["cwd"], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE if pattern else out,
                                stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as e:
        stop.set()
        return finish(d, status="failed", error=str(e))
    update_meta(d, status="running", pid=proc.pid)

    def watch_kill():
        # `bgtask kill` may run in another PID namespace, so it asks through meta.json.
        while proc.poll() is None:
            if read_meta(d).get("kill_requested"):
                try:
                    os.killpg(proc.pid, 15)
                except ProcessLookupError:
                    pass
                return
            time.sleep(1)

    threading.Thread(target=watch_kill, daemon=True).start()

    if pattern:
        pending, lock = [], threading.Lock()

        def flush():
            with lock:
                batch = pending[:]
                pending.clear()
            if batch:
                deliver(d, read_meta(d), "match", "\n".join(batch)[-TAIL_CHARS:])

        timer = None
        for raw in proc.stdout:
            out.write(raw)
            line = raw.decode(errors="replace").rstrip("\n")
            if pattern.search(line):
                with lock:
                    pending.append(line)
                if timer is None or not timer.is_alive():
                    timer = threading.Timer(MATCH_WINDOW, flush)
                    timer.start()
        if timer:
            timer.cancel()
        flush()

    code = proc.wait()
    stop.set()
    if read_meta(d).get("kill_requested"):
        status = "killed"
    else:
        status = "completed" if code == 0 else "failed"
    finish(d, status=status, exit_code=code)


def spawn_supervisor(task_id):
    d = HOME / task_id
    subprocess.Popen([sys.executable, "-I", os.path.realpath(__file__), "_supervise", task_id],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=open(d / "supervisor.log", "ab"), start_new_session=True)


def cmd_run(a):
    argv = a.command
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        sys.exit("bgtask: missing command")
    if len(argv) == 1:
        argv = ["bash", "-c", argv[0]]
    if a.match:
        re.compile(a.match)
    sandboxed = in_codex_sandbox()
    if sandboxed and re.search(r"\bbazel(isk)?\b", " ".join(argv)):
        sys.exit("bgtask: Bazel can't write its output base under /workspace/.cache from the Codex "
                 "sandbox, so this task would fail with exit 36. Rerun the same `bgtask run` "
                 "command with escalated permissions.")
    if sandboxed and not fresh(HOME / "daemon.heartbeat"):
        sys.exit("bgtask: the bgtask daemon is not running, and a task started inside the Codex "
                 "sandbox dies with the command that started it. Start the daemon outside the "
                 "sandbox (run `bgtask daemon --ensure` with escalated permissions), then retry.")
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    task_id = secrets.token_hex(4)
    d = HOME / task_id
    d.mkdir(mode=0o700)
    meta = {"id": task_id, "name": a.name or " ".join(argv)[:80], "argv": argv,
            "cwd": os.path.abspath(a.cwd or os.getcwd()), "match": a.match,
            "sandboxed": sandboxed, "status": "queued", "exit_code": None,
            "started": now(), "finished": None, "output": str(d / "output.log")}
    (d / "output.log").touch()
    targets = list(a.notify or [])
    thread = os.environ.get("CODEX_THREAD_ID")
    # T3 runs Codex on its own app server, which `codex queue` doesn't reach.
    under_t3 = os.environ.get("CODEX_INTERNAL_ORIGINATOR_OVERRIDE") == "T3 Code"
    if thread and not a.no_notify and not under_t3:
        targets.append(f"codex:{thread}")
    for t in targets:
        add_subscriber(d, t)
    write_meta(d, meta)
    if sandboxed:
        (d / "queued").touch()  # the daemon claims it by renaming this file
    else:
        spawn_supervisor(task_id)
    print(f"task {task_id} {'queued for the bgtask daemon' if sandboxed else 'started'}: {meta['name']}")
    print(f"output: {meta['output']}")
    if targets:
        print("notify: " + ", ".join(targets))
    elif thread and under_t3:
        print(f"notify: none; bgtask can't wake a Codex session under T3. To stay async, start an "
              f"async delegate_task child (codex, gpt-6-luna) that runs `bgtask wait {task_id} "
              f"--timeout 3600` until it exits, then continue or end the turn; T3 wakes you when "
              f"the child finishes.")
    else:
        print(f"notify: none; check with `bgtask status {task_id}`")


def cmd_daemon(a):
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    if in_codex_sandbox():
        sys.exit("bgtask: the daemon must run outside the Codex sandbox")
    if a.ensure:
        if fresh(HOME / "daemon.heartbeat"):
            return
        subprocess.Popen([sys.executable, "-I", os.path.realpath(__file__), "daemon"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=open(HOME / "daemon.log", "ab"), start_new_session=True)
        for _ in range(50):
            if fresh(HOME / "daemon.heartbeat"):
                print("bgtask daemon started")
                return
            time.sleep(0.1)
        sys.exit(f"bgtask: daemon did not start; see {HOME / 'daemon.log'}")
    lock = open(HOME / "daemon.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return  # another daemon is running
    (HOME / "daemon.pid").write_text(f"{os.getpid()}\n")
    while True:
        (HOME / "daemon.heartbeat").touch()
        for q in HOME.glob("*/queued"):
            try:
                q.rename(q.with_name("claimed"))
            except FileNotFoundError:
                continue
            spawn_supervisor(q.parent.name)
        time.sleep(0.5)


def cmd_subscribe(a):
    d = task_dir(a.id)
    add_subscriber(d, a.target)
    meta = read_meta(d)
    if meta["finished"]:
        deliver(d, meta, "exit", tail(d / "output.log"), only=a.target)
        print(f"task {a.id} already {meta['status']}; notified {a.target}")
    else:
        print(f"{a.target} will be notified when task {a.id} finishes")


def cmd_list(a):
    if not HOME.exists():
        return
    rows = []
    for d in HOME.iterdir():
        if (d / "meta.json").exists():
            meta = read_meta(d)
            recent = meta["finished"] and time.time() - \
                datetime.datetime.fromisoformat(meta["finished"]).timestamp() < 3600
            if a.all or not meta["finished"] or recent:
                rows.append((meta["started"], meta["id"], effective_status(d, meta),
                             meta.get("exit_code"), meta["name"]))
    for started, tid, status, code, name in sorted(rows):
        print(f"{tid}  {status:9} {'' if code is None else code!s:>4}  {started}  {name}")


def cmd_status(a):
    d = task_dir(a.id)
    meta = read_meta(d)
    meta["status"] = effective_status(d, meta)
    meta["subscribers"] = subscribers(d)
    print(json.dumps(meta, indent=2))


def cmd_logs(a):
    print(tail(task_dir(a.id) / "output.log", lines=a.lines, chars=10**9))


def cmd_kill(a):
    d = task_dir(a.id)
    meta = read_meta(d)
    if meta["finished"]:
        sys.exit(f"bgtask: task {a.id} already {meta['status']}")
    update_meta(d, kill_requested=True)
    print(f"kill requested for task {a.id}")


def cmd_wait(a):
    d = task_dir(a.id)
    deadline = time.time() + a.timeout if a.timeout else None
    while not (meta := read_meta(d))["finished"]:
        status = effective_status(d, meta)
        if status not in ("running", "queued"):
            sys.exit(f"bgtask: task {a.id} is {status}")
        if deadline and time.time() > deadline:
            sys.exit(f"bgtask: task {a.id} still running after {a.timeout}s")
        time.sleep(1)
    print(render(meta, "exit", tail(d / "output.log")))
    sys.exit(0 if meta["status"] == "completed" else 1)


def main():
    p = argparse.ArgumentParser(prog="bgtask", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="start a background task")
    r.add_argument("--name")
    r.add_argument("--cwd")
    r.add_argument("--notify", action="append", metavar="TARGET",
                   help="codex:THREAD or exec:COMMAND; repeatable")
    r.add_argument("--no-notify", action="store_true", help="don't subscribe $CODEX_THREAD_ID")
    r.add_argument("--match", metavar="REGEX",
                   help="also notify on output lines matching REGEX while running")
    r.add_argument("command", nargs=argparse.REMAINDER)
    s = sub.add_parser("subscribe", help="notify TARGET when a task finishes")
    s.add_argument("id")
    s.add_argument("target")
    ls = sub.add_parser("list", help="unfinished tasks and those finished in the last hour")
    ls.add_argument("--all", action="store_true")
    for name in ("status", "kill"):
        sub.add_parser(name).add_argument("id")
    lg = sub.add_parser("logs")
    lg.add_argument("id")
    lg.add_argument("-n", "--lines", type=int, default=100)
    w = sub.add_parser("wait", help="block until a task finishes; exit 0 if it succeeded")
    w.add_argument("id")
    w.add_argument("--timeout", type=int)
    dm = sub.add_parser("daemon", help="run sandboxed tasks; must run outside the Codex sandbox")
    dm.add_argument("--ensure", action="store_true", help="start in the background unless running")
    sup = sub.add_parser("_supervise")
    sup.add_argument("id")
    a = p.parse_args()
    if a.cmd == "_supervise":
        return supervise(a.id)
    {"run": cmd_run, "subscribe": cmd_subscribe, "list": cmd_list, "status": cmd_status,
     "logs": cmd_logs, "kill": cmd_kill, "wait": cmd_wait, "daemon": cmd_daemon}[a.cmd](a)


if __name__ == "__main__":
    main()
