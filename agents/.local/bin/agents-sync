#!/usr/bin/env zsh
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$LOG_DIR/agents-sync.log"
mkdir -p "$LOG_DIR"
log() { print -r -- "$(date '+%F %T') $*" >>"$LOG"; }

cd "$DOTFILES"
if ! git fetch origin main --quiet; then
  log "fetch failed"
  exit 0
fi
behind=$(git rev-list --count main..origin/main)
if (( behind > 0 )); then
  if [[ -z $(git status --porcelain --untracked-files=no) ]]; then
    if git pull --ff-only origin main --quiet; then
      log "pulled $behind commits"
    else
      log "pull failed, not fast-forward or conflict; skipping"
      exit 0
    fi
  else
    log "dirty tree, skipped pull ($behind behind)"
  fi
fi

case "$(uname -s)" in
  Darwin) host_file="host-mac.md" ;;
  *)      host_file="host-linux.md" ;;
esac
ln -sfn "$DOTFILES/agents/$host_file" "$DOTFILES/agents/host.md"

if [[ -n "${CODEX_HOME:-}" ]]; then
  codex_home="$CODEX_HOME"
elif [[ "$(uname -s)" == "Linux" && -d /workspace/.codex ]]; then
  codex_home="/workspace/.codex"
else
  codex_home="$HOME/.codex"
fi
mkdir -p "$codex_home"
# Each tool gets one file with the shared rules plus its own: bullets that start
# with "- Codex" go only to Codex, and bullets that start with "- Claude" only to
# Claude. The @file includes are inlined, since the file no longer sits next to them.
render() {
  local skip="$1"
  grep -v -e '^@[A-Za-z0-9._-]*\.md$' -e "^- $skip" "$DOTFILES/agents/common.md"
  local extra
  for extra in host.md wayve.md; do
    if [[ -f "$DOTFILES/agents/$extra" ]]; then
      echo
      grep -v "^- $skip" "$DOTFILES/agents/$extra"
    fi
  done
}
render Claude > "$codex_home/AGENTS.md"
cp "$DOTFILES/agents/codex-hooks.json" "$codex_home/hooks.json.new"
if ! cmp -s "$codex_home/hooks.json.new" "$codex_home/hooks.json"; then
  mv "$codex_home/hooks.json.new" "$codex_home/hooks.json"
  log "codex hooks.json changed; trust the new hooks with /hooks in Codex"
else
  rm "$codex_home/hooks.json.new"
fi

if [[ "$(uname -s)" == "Linux" && -d /workspace/.claude ]]; then
  claude_dir="/workspace/.claude"
else
  claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
fi
mkdir -p "$claude_dir"
# mv replaces the old symlink to common.md instead of writing through it.
render Codex > "$claude_dir/CLAUDE.md.new"
mv "$claude_dir/CLAUDE.md.new" "$claude_dir/CLAUDE.md"

# Agent tools on PATH.
if [[ "$(uname -s)" == "Linux" && -d /workspace/.local/bin ]]; then
  bin_dir="/workspace/.local/bin"
else
  bin_dir="$HOME/.local/bin"
fi
mkdir -p "$bin_dir"
for tool in agents-audit; do
  ln -sfn "$DOTFILES/agents/.local/bin/$tool" "$bin_dir/$tool"
done
# Machine-local tools (gitignored), such as work-specific helpers.
for tool in "$DOTFILES"/agents/wayve-local/bin/*(N); do
  ln -sfn "$tool" "$bin_dir/${tool:t}"
done
# Machine-local setup scripts (gitignored), such as installing work tools; each
# gets the bin directory as its argument.
for script in "$DOTFILES"/agents/wayve-local/sync.d/*(N); do
  [[ -x "$script" ]] && { "$script" "$bin_dir" || log "${script:t} failed"; }
done
if command -v tskr >/dev/null; then
  # Threads started before the rename still call bgtask.
  ln -sfn "$(command -v tskr)" "$bin_dir/bgtask"
  if [[ "$(uname -s)" == "Linux" ]]; then
    tskr daemon --ensure >/dev/null || log "tskr daemon failed to start"
  fi
fi
log "synced codex=$codex_home claude=$claude_dir"