#!/usr/bin/env zsh
# Render one instruction file per agent (Claude, Codex) from the shared rules
# plus the host and profile files, install hooks, and link agent tools.
#
# Inputs, in render order:
#   $DOTFILES/agents/common.md          shared by every machine
#   $DOTFILES/agents/host-{mac,linux}.md picked by OS
#   $DOTFILES/agents/private.md         profile=private (committed)
#   $DOTFILES_WORK/agents/work.md       profile=work (separate private repo)
#   $DOTFILES/agents/local.md           this machine only (gitignored)
# Bullets starting with "- Codex" go only to Codex, "- Claude" only to Claude.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
source "$DOTFILES/env/.config/env"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$LOG_DIR/agents-sync.log"
mkdir -p "$LOG_DIR"
log() { print -r -- "$(date '+%F %T') $*" >>"$LOG"; }

case "$(uname -s)" in
  Darwin) host_file="host-mac.md" ;;
  *)      host_file="host-linux.md" ;;
esac

typeset -a parts
parts=("$DOTFILES/agents/common.md" "$DOTFILES/agents/$host_file")
if [[ $DOTFILES_PROFILE == work ]]; then
  parts+=("$DOTFILES_WORK/agents/work.md")
else
  parts+=("$DOTFILES/agents/private.md")
fi
parts+=("$DOTFILES/agents/local.md")

render() {
  local skip="$1" part first=1
  for part in "${parts[@]}"; do
    [[ -f $part ]] || continue
    (( first )) || echo
    first=0
    grep -v -e '^@[A-Za-z0-9._-]*\.md$' -e "^- $skip" "$part" || true
  done
}

codex_home="${CODEX_HOME:-$WORKSPACE_ROOT/.codex}"
mkdir -p "$codex_home"
render Claude > "$codex_home/AGENTS.md"
cp "$DOTFILES/agents/codex-hooks.json" "$codex_home/hooks.json.new"
if ! cmp -s "$codex_home/hooks.json.new" "$codex_home/hooks.json"; then
  mv "$codex_home/hooks.json.new" "$codex_home/hooks.json"
  log "codex hooks.json changed; trust the new hooks with /hooks in Codex"
else
  rm "$codex_home/hooks.json.new"
fi

claude_dir="${CLAUDE_CONFIG_DIR:-$WORKSPACE_ROOT/.claude}"
mkdir -p "$claude_dir"
# mv replaces an old symlink to common.md instead of writing through it.
render Codex > "$claude_dir/CLAUDE.md.new"
mv "$claude_dir/CLAUDE.md.new" "$claude_dir/CLAUDE.md"

# Agent tools on PATH.
bin_dir="$WORKSPACE_ROOT/.local/bin"
mkdir -p "$bin_dir"
for tool in agents-sync agents-skills-sync agents-audit; do
  ln -sfn "$DOTFILES/agents/.local/bin/$tool" "$bin_dir/$tool"
done
# Work-only tools and setup scripts from the private repo; each setup script
# gets the bin directory as its argument.
if [[ $DOTFILES_PROFILE == work && -d $DOTFILES_WORK ]]; then
  for tool in "$DOTFILES_WORK"/agents/bin/*(N); do
    ln -sfn "$tool" "$bin_dir/${tool:t}"
  done
  for script in "$DOTFILES_WORK"/agents/sync.d/*(N); do
    [[ -x "$script" ]] && { "$script" "$bin_dir" || log "${script:t} failed"; }
  done
fi
if command -v tskr >/dev/null; then
  # Threads started before the rename still call bgtask.
  ln -sfn "$(command -v tskr)" "$bin_dir/bgtask"
  if [[ "$(uname -s)" == "Linux" ]]; then
    tskr daemon --ensure >/dev/null || log "tskr daemon failed to start"
  fi
fi
log "synced profile=$DOTFILES_PROFILE codex=$codex_home claude=$claude_dir"
