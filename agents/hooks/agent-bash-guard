#!/usr/bin/env python3
"""PreToolUse guard for agent shell commands (Claude Code and Codex).

Reads the hook JSON on stdin and denies:
- `git push` of a branch that is not main/master and not prefixed jangabrielmylius/.
- `pkill -f PATTERN` where PATTERN would also match the agent's own shell.
- `kill $(pgrep -f PATTERN)` and `pgrep -f PATTERN | xargs kill`, for the same reason.
Anything it cannot parse is allowed.
"""
import json
import os
import re
import shlex
import subprocess
import sys

PREFIX = "jangabrielmylius/"
ALLOWED = {"main", "master"}


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))
    sys.exit(0)


REDIRECT = re.compile(r"\d*(>>?|<<?<?|>&|<&)\S*|&>>?\S*")


def strip_redirects(argv):
    out, skip = [], False
    for a in argv:
        if skip:
            skip = False
        elif REDIRECT.fullmatch(a):
            # A bare operator such as `>` takes the next word as its target.
            skip = re.fullmatch(r"\d*(>>?|<<?<?|>&|<&)|&>>?", a) is not None
        else:
            out.append(a)
    return out


def segments(command):
    # Split on shell separators; good enough for agent one-liners.
    for part in re.split(r"&&|\|\||;|\||\n", command):
        try:
            yield strip_redirects(shlex.split(part))
        except ValueError:
            continue


def current_branch(cwd):
    try:
        out = subprocess.run(["git", "-C", cwd, "branch", "--show-current"],
                             capture_output=True, text=True, timeout=5)
        return out.stdout.strip() or None
    except Exception:
        return None


def check_push(argv, cwd):
    # argv starts at "git"; collect -C and find "push".
    i, git_dir = 1, cwd
    while i < len(argv) and argv[i] != "push":
        if argv[i] == "-C" and i + 1 < len(argv):
            git_dir = os.path.join(git_dir, argv[i + 1])
            i += 1
        elif not argv[i].startswith("-"):
            return  # some other git subcommand
        i += 1
    if i >= len(argv):
        return
    args = argv[i + 1:]
    if any(a in ("--delete", "-d", "--tags", "--all", "--mirror") for a in args):
        return
    positional = [a for a in args if not a.startswith("-")]
    refs = positional[1:]
    targets = []
    for ref in refs:
        dst = ref.split(":", 1)[1] if ":" in ref else ref
        if ":" in ref and ref.split(":", 1)[0] == "":
            continue  # ":branch" deletes
        dst = dst.lstrip("+").removeprefix("refs/heads/")
        if dst == "HEAD":
            dst = current_branch(git_dir)
        if dst and not dst.startswith("refs/tags/"):
            targets.append(dst)
    if not refs:
        targets.append(current_branch(git_dir))
    for branch in targets:
        if branch and branch not in ALLOWED and not branch.startswith(PREFIX):
            deny(f"Branch '{branch}' must be named {PREFIX}<product>/<change>. "
                 f"Rename it first: git branch -m {PREFIX}<product>/<change>, then push.")


def check_pkill(argv):
    if "-f" not in argv and "--full" not in argv and not any(
            re.fullmatch(r"-[a-zA-Z0-9]*f[a-zA-Z0-9]*", a) for a in argv[1:]):
        return
    patterns = [a for a in argv[1:] if not a.startswith("-")]
    if patterns and not any("[" in p for p in patterns):
        deny("pkill -f matches its own shell, whose command line contains the pattern, "
             "and kills it (exit 144). Bracket one character, e.g. pkill -f '[v]ite dev', "
             "or kill a saved PID.")


PGREP = re.compile(r"\bpgrep\b([^;|&)`]*)")


def check_pgrep_kill(command):
    # pgrep skips itself but not the shell running this command, whose
    # command line contains the pattern, so killing what it finds kills the shell.
    if not re.search(r"(?<![\w-])kill\b", command):
        return
    for m in PGREP.finditer(command):
        try:
            args = shlex.split(m.group(1))
        except ValueError:
            continue
        if "-f" not in args and "--full" not in args and not any(
                re.fullmatch(r"-[a-zA-Z0-9]*f[a-zA-Z0-9]*", a) for a in args):
            continue
        patterns = [a for a in args if not a.startswith("-")]
        if patterns and not any("[" in p for p in patterns):
            deny("Killing the PIDs from pgrep -f also kills this shell, whose command line "
                 "contains the pattern (exit 144). Bracket one character, e.g. "
                 "pgrep -f '[v]ite dev', or kill a saved PID.")


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    command = (data.get("tool_input") or {}).get("command")
    if isinstance(command, list):
        command = " ".join(command)
    if not isinstance(command, str):
        return
    cwd = data.get("cwd") or os.getcwd()
    check_pgrep_kill(command)
    for argv in segments(command):
        while argv and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", argv[0]):
            argv = argv[1:]  # leading VAR=value
        if not argv:
            continue
        if argv[0] == "cd" and len(argv) > 1:
            cwd = os.path.join(cwd, os.path.expanduser(argv[1]))
        elif argv[0] == "git":
            check_push(argv, cwd)
        elif argv[0] == "pkill":
            check_pkill(argv)


if __name__ == "__main__":
    main()
